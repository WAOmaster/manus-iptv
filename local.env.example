# Copy to local.env (git-ignored) and edit. Read by build.sh, install.sh, tools/*.sh.
# The ${VAR-default} form lets a variable set on the command line win: FLAVOR=play bash build.sh
FLAVOR=${FLAVOR-full}                       # full = GitHub/sideload build; play = Play Store build (no iptv-org anywhere)
DEFAULT_IPTVORG=${DEFAULT_IPTVORG-1}        # 1 = the free iptv-org list is pre-enabled (full flavour only)
FEED_URL=${FEED_URL-https://yourname.github.io/manus-iptv-data/}   # optional channel data feed (see README); empty = none
ANDROID_SDK=${ANDROID_SDK-/c/Users/you/AppData/Local/Android/Sdk}  # Git Bash path to the Android SDK
TV_IP=${TV_IP-192.168.1.50}                 # your TV's address for install.sh and tools/mirror.sh
SCRCPY_DIR=${SCRCPY_DIR-/mnt/c/Users/you/scrcpy}   # only for tools/mirror.sh (folder with scrcpy.exe and adb.exe)
